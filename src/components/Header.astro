---
const path = Astro.url.pathname;
const isHome = path === '/' || path === '';
const isBlog = path.startsWith('/blog');
---

<nav class="site-nav" id="navbar" data-home={isHome ? 'true' : 'false'}>
	<a href="/" class="nav-logo" aria-label="Home"><span>//</span> msp</a>

	<ul class="nav-links" id="navLinks" role="navigation" aria-label="Primary">
		{
			isHome ? (
				<>
					<li>
						<a href="#about">
							<span class="i18n i18n--en">About</span>
							<span class="i18n i18n--ko">소개</span>
						</a>
					</li>
					<li>
						<a href="#skills">
							<span class="i18n i18n--en">Skills</span>
							<span class="i18n i18n--ko">기술</span>
						</a>
					</li>
					<li>
						<a href="#projects">
							<span class="i18n i18n--en">Projects</span>
							<span class="i18n i18n--ko">프로젝트</span>
						</a>
					</li>
					<li>
						<a href="#competitive">CP</a>
					</li>
					<li>
						<a href="#contact">
							<span class="i18n i18n--en">Contact</span>
							<span class="i18n i18n--ko">연락</span>
						</a>
					</li>
					<li>
						<a href="/blog/">
							<span class="i18n i18n--en">Blog</span>
							<span class="i18n i18n--ko">블로그</span>
						</a>
					</li>
				</>
			) : (
				<>
					<li>
						<a href="/">
							<span class="i18n i18n--en">Portfolio</span>
							<span class="i18n i18n--ko">포트폴리오</span>
						</a>
					</li>
					<li>
						<a href="/blog/" class:list={{ active: isBlog }}>
							<span class="i18n i18n--en">Blog</span>
							<span class="i18n i18n--ko">블로그</span>
						</a>
					</li>
				</>
			)
		}
	</ul>

	<div class="lang-switch" role="group" aria-label="Language">
		<button type="button" class="lang-btn" data-lang="en" aria-pressed="false">EN</button>
		<button type="button" class="lang-btn" data-lang="ko" aria-pressed="false">KO</button>
	</div>

	<button type="button" class="nav-toggle" id="navToggle" aria-expanded="false" aria-label="Menu">
		<span></span><span></span><span></span>
	</button>
</nav>

<style>
	.site-nav {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		display: flex;
		align-items: center;
		justify-content: flex-start;
		gap: 1.25rem;
		padding: 1.25rem 2.5rem;
		background: rgba(10, 10, 10, 0.85);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid transparent;
		transition: border-color 0.3s;
		flex-wrap: wrap;
	}

	.site-nav.is-scrolled {
		border-color: var(--border);
	}

	.nav-logo {
		font-family: var(--font-mono);
		font-size: 0.9rem;
		color: var(--text-muted);
		letter-spacing: 0.1em;
		text-decoration: none;
		margin-right: auto;
	}

	.nav-logo span {
		color: var(--accent);
	}

	.nav-links {
		display: flex;
		gap: 2rem;
		list-style: none;
		margin: 0;
		padding: 0;
		align-items: center;
	}

	.nav-links a {
		font-size: 0.8rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--text-muted);
		text-decoration: none;
		transition: color 0.2s;
	}

	.nav-links a:hover,
	.nav-links a.active {
		color: var(--accent);
	}

	.lang-switch {
		display: flex;
		border: 1px solid var(--border);
		border-radius: 4px;
		overflow: hidden;
		flex-shrink: 0;
	}

	.lang-btn {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.08em;
		padding: 0.4rem 0.55rem;
		border: none;
		background: transparent;
		color: var(--text-dim);
		cursor: pointer;
		transition:
			background 0.15s,
			color 0.15s;
	}

	.lang-btn:hover {
		color: var(--text-muted);
	}

	.lang-btn.is-active {
		background: var(--bg3);
		color: var(--accent);
	}

	.nav-toggle {
		display: none;
		flex-direction: column;
		gap: 5px;
		cursor: pointer;
		background: none;
		border: none;
		padding: 0.25rem;
	}

	.nav-toggle span {
		width: 22px;
		height: 1px;
		background: var(--text);
		display: block;
		transition: 0.3s;
	}

	@media (max-width: 768px) {
		.site-nav {
			padding: 1rem 1.5rem;
		}

		.nav-logo {
			margin-right: 0;
		}

		.nav-links {
			display: none;
			flex-direction: column;
			width: 100%;
			order: 5;
			padding: 1rem 0 0;
			border-top: 1px solid var(--border);
			margin-top: 0.5rem;
			padding-top: 1.25rem;
			gap: 1.25rem;
			align-items: flex-start;
		}

		.nav-links.is-open {
			display: flex;
		}

		.lang-switch {
			margin-left: auto;
		}

		.nav-toggle {
			display: flex;
		}
	}
</style>

<script>
	function initNav() {
		const navbar = document.getElementById('navbar');
		const navLinks = document.getElementById('navLinks');
		const navToggle = document.getElementById('navToggle');
		const isHome = navbar?.dataset.home === 'true';

		function setScrolled() {
			if (!navbar) return;
			navbar.classList.toggle('is-scrolled', window.scrollY > 30);
		}

		function updateActive() {
			if (!isHome || !navbar || !navLinks) return;
			const links = navLinks.querySelectorAll('a[href^="#"]');
			let current = '';
			document.querySelectorAll('section[id]').forEach((s) => {
				const el = s;
				if (window.scrollY >= el.offsetTop - 120) current = el.id;
			});
			links.forEach((a) => {
				const href = a.getAttribute('href');
				a.classList.toggle('active', href === '#' + current);
			});
		}

		setScrolled();
		window.addEventListener('scroll', () => {
			setScrolled();
			updateActive();
		});
		updateActive();

		navToggle?.addEventListener('click', () => {
			const open = navLinks?.classList.toggle('is-open');
			navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
		});

		navLinks?.querySelectorAll('a').forEach((a) => {
			a.addEventListener('click', () => {
				navLinks.classList.remove('is-open');
				navToggle?.setAttribute('aria-expanded', 'false');
			});
		});
	}

	initNav();
	document.addEventListener('astro:page-load', initNav);
</script>
