---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

function formatDate(d: Date) {
	return new Intl.DateTimeFormat('ko-KR', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	}).format(d);
}
---

<BaseLayout title="Blog | Min-Seong Park" description="기술 글과 메모">
	<div class="page-head">
		<p class="section-label">
			<span class="i18n i18n--en">Writing</span>
			<span class="i18n i18n--ko">글</span>
		</p>
		<h1 class="page-title">
			<span class="i18n i18n--en">Blog</span>
			<span class="i18n i18n--ko">블로그</span>
		</h1>
		<p class="lead i18n i18n--en">Add Markdown posts under <code>src/content/blog/</code>.</p>
		<p class="lead i18n i18n--ko">마크다운 글은 <code>src/content/blog/</code>에 추가합니다.</p>
	</div>
	<div class="post-grid">
		{
			posts.map((post) => (
				<a href={`/blog/${post.id}/`} class="post-card">
					<span class="date">{formatDate(post.data.pubDate)}</span>
					<h2>{post.data.title}</h2>
					<p>{post.data.description}</p>
				</a>
			))
		}
	</div>
</BaseLayout>

<style>
	.page-head {
		max-width: var(--max);
		margin-bottom: 2.5rem;
	}

	.section-label {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--text-dim);
		letter-spacing: 0.25em;
		text-transform: uppercase;
		margin: 0 0 0.75rem;
	}

	.page-title {
		font-size: clamp(2rem, 4vw, 2.75rem);
		margin: 0 0 0.75rem;
		letter-spacing: -0.02em;
	}

	.lead {
		margin: 0;
		color: var(--text-muted);
		font-size: 1rem;
		font-weight: 300;
		line-height: 1.7;
	}

	.post-grid {
		display: flex;
		flex-direction: column;
		gap: 1px;
		background: var(--border);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
		max-width: var(--max-wide);
	}

	.post-card {
		display: block;
		padding: 1.75rem 2rem;
		background: var(--bg2);
		text-decoration: none;
		color: inherit;
		transition: background 0.2s;
	}

	.post-card:hover {
		background: var(--bg3);
	}

	.post-card .date {
		display: block;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--text-dim);
		margin-bottom: 0.5rem;
		letter-spacing: 0.08em;
	}

	.post-card h2 {
		margin: 0 0 0.5rem;
		font-size: 1.1rem;
		font-weight: 600;
		color: var(--text);
	}

	.post-card p {
		margin: 0;
		font-size: 0.88rem;
		color: var(--text-dim);
		line-height: 1.65;
	}
</style>
