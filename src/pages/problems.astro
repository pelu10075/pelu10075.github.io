---
import BaseLayout from '../layouts/BaseLayout.astro';
import { REPO_URL, LC_REPO_URL } from '../lib/cfSearch';

const repoUrl   = REPO_URL;
const lcRepoUrl = LC_REPO_URL;
---

<BaseLayout title="Problems · pelu10075" description="Codeforces / LeetCode 문제 풀이 검색">
<main class="prb-main">

	<!-- ── Hero ─────────────────────────────────────────────── -->
	<header class="prb-hero">
		<nav class="prb-nav">
			<a href="/">← portfolio</a>
			<span class="prb-nav-sep">/</span>
			<a href="/problems">problems</a>
		</nav>
		<h1>Problems</h1>
		<p class="prb-subtitle">
			<span class="i18n i18n--en">Solved problems from Codeforces &amp; LeetCode — with difficulty, tags, and solution folders.</span>
			<span class="i18n i18n--ko">Codeforces · LeetCode 풀이 이력 — 난이도, 태그, 풀이 폴더를 확인합니다.</span>
		</p>
		<div class="prb-repo-links">
			<a href={repoUrl} target="_blank" rel="noopener noreferrer" class="prb-repo-btn">
				<svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
				</svg>
				pelu10075/codeforces
			</a>
			<a href={lcRepoUrl} target="_blank" rel="noopener noreferrer" class="prb-repo-btn">
				<svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
				</svg>
				pelu10075/leetcode
			</a>
		</div>
	</header>

	<!-- ── Source tabs ──────────────────────────────────────── -->
	<div class="prb-tabs" role="tablist">
		<button id="tab-cf" class="prb-tab prb-tab--active" role="tab" aria-selected="true">
			Codeforces
		</button>
		<button id="tab-lc" class="prb-tab" role="tab" aria-selected="false">
			LeetCode
		</button>
	</div>

	<!-- ── Search bar ───────────────────────────────────────── -->
	<div class="search-bar">
		<input id="cf-search" type="text" autocomplete="off" spellcheck="false" />
		<span id="cf-count"></span>
	</div>

	<!-- ── Loading / Error ──────────────────────────────────── -->
	<div id="cf-loading" class="prb-status">
		<span class="i18n i18n--en">Loading…</span>
		<span class="i18n i18n--ko">불러오는 중…</span>
	</div>
	<div id="cf-error" class="prb-status prb-error" hidden>
		<span id="cf-error-msg"></span>
		<button id="cf-retry" class="prb-retry-btn">Retry</button>
	</div>

	<!-- ── Codeforces table ──────────────────────────────────── -->
	<div id="cf-panel" hidden>
		<table>
			<thead>
				<tr>
					<th>ID</th>
					<th><span class="i18n i18n--en">Title</span><span class="i18n i18n--ko">제목</span></th>
					<th><span class="i18n i18n--en">Tags</span><span class="i18n i18n--ko">태그</span></th>
					<th><span class="i18n i18n--en">Diff</span><span class="i18n i18n--ko">난이도</span></th>
					<th><span class="i18n i18n--en">Contest</span><span class="i18n i18n--ko">대회</span></th>
					<th>AC</th>
					<th><span class="i18n i18n--en">Folder</span><span class="i18n i18n--ko">폴더</span></th>
				</tr>
			</thead>
			<tbody id="cf-tbody"></tbody>
		</table>
		<p id="cf-no-results" class="prb-empty" hidden>
			<span class="i18n i18n--en">No matches.</span>
			<span class="i18n i18n--ko">결과 없음.</span>
		</p>
	</div>

	<!-- ── LeetCode table ────────────────────────────────────── -->
	<div id="lc-panel" hidden>
		<table>
			<thead>
				<tr>
					<th>#</th>
					<th><span class="i18n i18n--en">Title</span><span class="i18n i18n--ko">제목</span></th>
					<th><span class="i18n i18n--en">Difficulty</span><span class="i18n i18n--ko">난이도</span></th>
					<th><span class="i18n i18n--en">Tags</span><span class="i18n i18n--ko">태그</span></th>
					<th><span class="i18n i18n--en">File</span><span class="i18n i18n--ko">파일</span></th>
				</tr>
			</thead>
			<tbody id="lc-tbody"></tbody>
		</table>
		<p id="lc-no-results" class="prb-empty" hidden>
			<span class="i18n i18n--en">No matches.</span>
			<span class="i18n i18n--ko">결과 없음.</span>
		</p>
	</div>

</main>

<!-- ── Code viewer modal ───────────────────────────────────────── -->
<div id="code-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title" hidden>
	<div id="modal-backdrop" class="modal-backdrop"></div>
	<div class="modal-box">
		<header class="modal-header">
			<div class="modal-meta">
				<span id="modal-title" class="modal-title-text"></span>
				<span id="modal-filename" class="modal-filename"></span>
			</div>
			<div class="modal-actions">
				<a id="modal-gh-link" class="modal-gh-link" href="#" target="_blank" rel="noopener noreferrer">↗ GitHub</a>
				<button id="modal-close" class="modal-close" aria-label="Close">✕</button>
			</div>
		</header>
		<div id="modal-filepicker" class="modal-filepicker" hidden>
			<ul id="modal-filelist" class="modal-filelist"></ul>
		</div>
		<div class="modal-code-wrap">
			<div id="modal-loading" class="modal-status">
				<span class="i18n i18n--en">Loading…</span>
				<span class="i18n i18n--ko">불러오는 중…</span>
			</div>
			<pre id="modal-pre" hidden><code id="modal-code"></code></pre>
			<div id="modal-err" class="modal-status modal-status--err" hidden>
				<span class="i18n i18n--en">Failed to load file.</span>
				<span class="i18n i18n--ko">파일을 불러오지 못했습니다.</span>
			</div>
		</div>
	</div>
</div>
</BaseLayout>

<style is:global>
	/* hidden attribute always wins */
	[hidden] { display: none !important; }

	/* ── Variables ───────────────────────────────────────────── */
	:root {
		--prb-mono:       'Space Mono', monospace;
		--prb-border:     #2a2a2a;
		--prb-text:       #f0f0f0;
		--prb-tag-border: #3a3a3a;
	}

	/* ── Layout ──────────────────────────────────────────────── */
	.prb-main { max-width: 1000px; margin: 0 auto; padding: 2rem 1.5rem 6rem; }

	/* ── Hero ────────────────────────────────────────────────── */
	.prb-hero { padding: 2.5rem 0 1.75rem; border-bottom: 1px solid var(--prb-border); }
	.prb-nav {
		font-family: var(--prb-mono); font-size: 0.7rem; color: #555;
		display: flex; align-items: center; gap: 0.4rem; margin-bottom: 1.25rem;
	}
	.prb-nav a { color: #888; text-decoration: none; transition: color 0.15s; }
	.prb-nav a:hover { color: var(--prb-text); }
	.prb-nav-sep { color: var(--prb-border); }
	.prb-hero h1 {
		font-size: clamp(1.9rem, 4vw, 2.8rem); font-weight: 700;
		letter-spacing: -0.03em; margin: 0 0 0.6rem; color: var(--prb-text);
	}
	.prb-subtitle { font-size: 0.92rem; color: #888; margin: 0 0 1.25rem; line-height: 1.6; }
	.prb-repo-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.prb-repo-btn {
		display: inline-flex; align-items: center; gap: 0.45rem;
		font-family: var(--prb-mono); font-size: 0.76rem; color: #888;
		text-decoration: none; padding: 0.4rem 0.85rem;
		border: 1px solid var(--prb-border); border-radius: 4px;
		transition: border-color 0.2s, color 0.2s;
	}
	.prb-repo-btn:hover { border-color: #555; color: var(--prb-text); }

	/* ── Tabs ────────────────────────────────────────────────── */
	.prb-tabs {
		display: flex; gap: 0; border-bottom: 1px solid var(--prb-border);
		margin-top: 1.5rem;
	}
	.prb-tab {
		font-family: var(--prb-mono); font-size: 0.72rem; letter-spacing: 0.08em;
		text-transform: uppercase; background: transparent; border: none;
		color: #555; padding: 0.6rem 1.1rem; cursor: pointer;
		border-bottom: 2px solid transparent; margin-bottom: -1px;
		transition: color 0.15s, border-color 0.15s;
	}
	.prb-tab:hover { color: #aaa; }
	.prb-tab--active { color: var(--prb-text); border-bottom-color: var(--prb-text); }

	/* ── Search bar ──────────────────────────────────────────── */
	.search-bar {
		display: flex; align-items: center; gap: 0.85rem;
		padding: 0.9rem 0; border-bottom: 1px solid var(--prb-border);
	}
	#cf-search {
		flex: 1; background: transparent; border: 1px solid var(--prb-border);
		border-radius: 4px; color: var(--prb-text); font-family: var(--prb-mono);
		font-size: 0.875rem; padding: 0.6rem 0.9rem; outline: none;
		transition: border-color 0.2s;
	}
	#cf-search:focus { border-color: #666; }
	#cf-search::placeholder { color: #444; }
	#cf-count { font-family: var(--prb-mono); font-size: 0.68rem; color: #555; white-space: nowrap; flex-shrink: 0; }

	/* ── Status ──────────────────────────────────────────────── */
	.prb-status {
		display: flex; align-items: center; gap: 0.75rem;
		padding: 2.25rem 0; font-family: var(--prb-mono); font-size: 0.8rem; color: #555;
	}
	.prb-error { color: #cc4444; }
	.prb-retry-btn {
		font-family: var(--prb-mono); font-size: 0.72rem; background: transparent;
		border: 1px solid #cc4444; color: #cc4444; border-radius: 3px;
		padding: 0.25rem 0.65rem; cursor: pointer; transition: background 0.15s;
	}
	.prb-retry-btn:hover { background: rgba(204,68,68,0.12); }

	/* ── Table ───────────────────────────────────────────────── */
	.prb-main table { width: 100%; border-collapse: collapse; font-family: var(--prb-mono); }
	.prb-main th {
		font-size: 0.6rem; letter-spacing: 0.1em; text-transform: uppercase;
		color: #555; font-weight: 400; padding: 0.5rem 0.85rem; text-align: left;
		border-bottom: 1px solid var(--prb-border); white-space: nowrap; background: #111;
	}
	.prb-main td {
		padding: 0.6rem 0.85rem; border-bottom: 1px solid var(--prb-border);
		vertical-align: middle; font-size: 0.84rem;
	}
	.prb-main tbody tr:last-child td { border-bottom: none; }
	.prb-main tbody tr { transition: background 0.1s; }
	.prb-main tbody tr:hover { background: #1a1a1a; }

	/* ── ID ──────────────────────────────────────────────────── */
	.prb-id { font-family: var(--prb-mono); font-weight: 700; font-size: 0.88rem; letter-spacing: 0.05em; }
	.prb-id--solved   { color: #f0f0f0; }
	.prb-id--unsolved { color: #555; }

	/* ── Title ───────────────────────────────────────────────── */
	.prb-title-cell { font-size: 0.84rem; color: #aaa; }
	.prb-title-cell a { color: inherit; text-decoration: none; transition: color 0.15s; }
	.prb-title-cell a:hover { color: var(--prb-text); }

	/* ── Tags ────────────────────────────────────────────────── */
	.prb-tags { display: flex; flex-wrap: wrap; gap: 0.3rem; min-width: 0; }
	.prb-tag {
		display: inline-block; padding: 2px 7px;
		border: 1px solid var(--prb-tag-border); font-size: 0.7rem;
		font-family: var(--prb-mono); background: transparent;
		border-radius: 3px; color: #777; white-space: nowrap; line-height: 1.5;
	}

	/* ── Difficulty ──────────────────────────────────────────── */
	.prb-diff { font-family: var(--prb-mono); font-size: 0.8rem; font-weight: 700; white-space: nowrap; }

	/* ── CF-specific ─────────────────────────────────────────── */
	.prb-contest-link { font-family: var(--prb-mono); font-size: 0.76rem; color: #666; text-decoration: none; white-space: nowrap; transition: color 0.15s; }
	.prb-contest-link:hover { color: #aaa; }
	.prb-ac { font-family: var(--prb-mono); font-size: 0.78rem; font-weight: 700; color: #4caf50; }
	.prb-ac--no { color: #333; }
	.prb-folder-link {
		font-family: var(--prb-mono); font-size: 0.7rem; color: #666; text-decoration: none;
		padding: 0.15rem 0.45rem; border: 1px solid var(--prb-border); border-radius: 3px;
		transition: border-color 0.15s, color 0.15s; white-space: nowrap;
	}
	.prb-folder-link:hover { border-color: #555; color: var(--prb-text); }

	/* ── LC difficulty badge ─────────────────────────────────── */
	.prb-lc-diff {
		font-family: var(--prb-mono); font-size: 0.78rem; font-weight: 700; white-space: nowrap;
	}

	/* ── Empty ───────────────────────────────────────────────── */
	.prb-empty { padding: 1.5rem 0.85rem; font-family: var(--prb-mono); font-size: 0.8rem; color: #444; margin: 0; }

	/* ── View button ─────────────────────────────────────────── */
	.prb-view-btn {
		font-family: var(--prb-mono); font-size: 0.7rem; color: #666;
		background: transparent; border: 1px solid var(--prb-border);
		border-radius: 3px; padding: 0.15rem 0.5rem; cursor: pointer;
		transition: border-color 0.15s, color 0.15s; white-space: nowrap;
	}
	.prb-view-btn:hover { border-color: #555; color: var(--prb-text); }

	/* ── Modal backdrop ──────────────────────────────────────── */
	.modal-backdrop {
		position: fixed; inset: 0; background: rgba(0,0,0,0.8);
		z-index: 900; cursor: pointer;
	}
	#code-modal {
		position: fixed; inset: 0; z-index: 901;
		display: flex; align-items: center; justify-content: center;
		padding: 1.5rem;
	}
	#code-modal[hidden] { display: none; }

	/* ── Modal box ───────────────────────────────────────────── */
	.modal-box {
		position: relative; z-index: 902;
		background: #111; border: 1px solid #333; border-radius: 6px;
		width: 100%; max-width: 760px; max-height: 82vh;
		display: flex; flex-direction: column; overflow: hidden;
		box-shadow: 0 24px 64px rgba(0,0,0,0.7);
	}
	.modal-header {
		display: flex; align-items: center; justify-content: space-between;
		padding: 0.7rem 1rem; border-bottom: 1px solid var(--prb-border);
		flex-shrink: 0; gap: 0.75rem;
	}
	.modal-meta { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; flex: 1; }
	.modal-title-text { font-family: var(--prb-mono); font-size: 0.8rem; color: #f0f0f0; font-weight: 700; }
	.modal-filename   { font-family: var(--prb-mono); font-size: 0.7rem; color: #666; }
	.modal-actions    { display: flex; align-items: center; gap: 0.5rem; flex-shrink: 0; }
	.modal-gh-link {
		font-family: var(--prb-mono); font-size: 0.68rem; color: #666;
		text-decoration: none; padding: 0.2rem 0.5rem;
		border: 1px solid var(--prb-border); border-radius: 3px;
		transition: border-color 0.15s, color 0.15s;
	}
	.modal-gh-link:hover { border-color: #555; color: #aaa; }
	.modal-close {
		background: transparent; border: none; color: #666; cursor: pointer;
		font-size: 0.85rem; padding: 0.2rem 0.4rem; border-radius: 3px;
		line-height: 1; transition: color 0.15s;
	}
	.modal-close:hover { color: #f0f0f0; }

	/* ── File picker ─────────────────────────────────────────── */
	.modal-filepicker { border-bottom: 1px solid var(--prb-border); flex-shrink: 0; }
	.modal-filelist   { list-style: none; margin: 0; padding: 0.35rem 0; }
	.modal-filelist li button {
		display: block; width: 100%; text-align: left; background: transparent;
		border: none; color: #888; font-family: var(--prb-mono); font-size: 0.78rem;
		padding: 0.3rem 1rem; cursor: pointer; transition: background 0.1s, color 0.1s;
	}
	.modal-filelist li button:hover  { background: #1a1a1a; color: #f0f0f0; }
	.modal-filelist li button.active { background: #1e1e1e; color: #f0f0f0; }

	/* ── Code area ───────────────────────────────────────────── */
	.modal-code-wrap { flex: 1; overflow: auto; min-height: 0; }
	.modal-status {
		padding: 1.5rem 1rem; font-family: var(--prb-mono); font-size: 0.78rem; color: #555;
	}
	.modal-status--err { color: #cc4444; }
	#modal-pre {
		margin: 0; padding: 1rem 1.25rem;
		font-family: var(--prb-mono); font-size: 0.8rem; line-height: 1.7;
		color: #c8c8c8; white-space: pre; tab-size: 4;
		counter-reset: line;
	}
	#modal-pre code { display: block; }

	/* ── Responsive ──────────────────────────────────────────── */
	@media (max-width: 760px) {
		.prb-main td:nth-child(5), .prb-main th:nth-child(5),
		.prb-main td:nth-child(6), .prb-main th:nth-child(6) { display: none; }
		.modal-box { max-height: 92vh; }
	}
	@media (max-width: 540px) {
		.prb-main td:nth-child(3), .prb-main th:nth-child(3) { display: none; }
		#code-modal { padding: 0; align-items: flex-end; }
		.modal-box  { max-width: 100%; border-radius: 12px 12px 0 0; max-height: 90vh; }
	}
</style>

<script>
	import {
		loadCF, loadLC,
		searchCF, searchLC,
		cfDiffColor, lcDiffColor,
		TREE_BASE,
	} from '../lib/cfSearch';
	import type { ProblemEntry, LCProblemEntry } from '../lib/cfSearch';

	// ── DOM ─────────────────────────────────────────────────────
	const input     = document.getElementById('cf-search')     as HTMLInputElement;
	const countEl   = document.getElementById('cf-count')      as HTMLElement;
	const loadingEl = document.getElementById('cf-loading')    as HTMLElement;
	const errorEl   = document.getElementById('cf-error')      as HTMLElement;
	const errorMsg  = document.getElementById('cf-error-msg')  as HTMLElement;
	const retryBtn  = document.getElementById('cf-retry')      as HTMLButtonElement;
	const tabCF     = document.getElementById('tab-cf')        as HTMLButtonElement;
	const tabLC     = document.getElementById('tab-lc')        as HTMLButtonElement;
	const cfPanel   = document.getElementById('cf-panel')      as HTMLElement;
	const lcPanel   = document.getElementById('lc-panel')      as HTMLElement;
	const cfTbody   = document.getElementById('cf-tbody')      as HTMLTableSectionElement;
	const lcTbody   = document.getElementById('lc-tbody')      as HTMLTableSectionElement;
	const cfEmpty   = document.getElementById('cf-no-results') as HTMLElement;
	const lcEmpty   = document.getElementById('lc-no-results') as HTMLElement;

	let cfEntries: ProblemEntry[] = [];
	let lcEntries: LCProblemEntry[] = [];
	let activeTab: 'cf' | 'lc' = 'cf';

	// ── Placeholders per tab ─────────────────────────────────────
	const PLACEHOLDER = {
		cf: 'Search by ID, contest, tag…  e.g. 2220, A, 2220A, greedy',
		lc: 'Search by #, title, tag, difficulty…  e.g. 1, two sum, easy',
	};

	// ── Render: Codeforces ───────────────────────────────────────
	function renderCFRow(p: ProblemEntry): HTMLTableRowElement {
		const tr     = document.createElement('tr');
		const color  = cfDiffColor(p.difficulty);
		const cfUrl  = `https://codeforces.com/contest/${p.contestId}/problem/${p.id.replace(/^\d+/, '')}`;
		const conUrl = `https://codeforces.com/contest/${p.contestId}`;
		const fUrl   = p.folderPath ? `${TREE_BASE}/${p.folderPath}` : null;

		const tags = p.tags.length
			? `<div class="prb-tags">${p.tags.map((t) => `<span class="prb-tag">${t}</span>`).join('')}</div>`
			: '<span style="color:#333">—</span>';
		const diff = p.difficulty
			? `<span class="prb-diff" style="color:${color}">*${p.difficulty}</span>`
			: `<span class="prb-diff" style="color:#555">?</span>`;
		const ac   = p.solved
			? `<span class="prb-ac">✓</span>`
			: `<span class="prb-ac prb-ac--no">—</span>`;
		const folder = p.folderPath
			? `<button class="prb-view-btn" data-cf-folder="${p.folderPath}" data-cf-id="${p.id}">${p.id}/</button>`
			: `<span style="color:#333">—</span>`;

		tr.innerHTML = `
			<td><span class="prb-id ${p.solved ? 'prb-id--solved' : 'prb-id--unsolved'}">${p.id}</span></td>
			<td class="prb-title-cell"><a href="${cfUrl}" target="_blank" rel="noopener noreferrer">${p.title || p.id}</a></td>
			<td>${tags}</td>
			<td>${diff}</td>
			<td><a href="${conUrl}" target="_blank" rel="noopener noreferrer" class="prb-contest-link">#${p.contestId}</a></td>
			<td>${ac}</td>
			<td>${folder}</td>`;
		return tr;
	}

	// ── Render: LeetCode ─────────────────────────────────────────
	function renderLCRow(p: LCProblemEntry): HTMLTableRowElement {
		const tr    = document.createElement('tr');
		const color = lcDiffColor(p.difficulty);
		const url   = `https://leetcode.com/problems/${p.titleSlug}/`;

		const tags = p.tags.length
			? `<div class="prb-tags">${p.tags.map((t) => `<span class="prb-tag">${t}</span>`).join('')}</div>`
			: '<span style="color:#333">—</span>';

		const fileHtml = `<button class="prb-view-btn" data-lc-file="${p.filePath}" data-lc-id="${p.id}">${p.filePath}</button>`;

		tr.innerHTML = `
			<td><span class="prb-id prb-id--solved">${p.id}</span></td>
			<td class="prb-title-cell"><a href="${url}" target="_blank" rel="noopener noreferrer">${p.title}</a></td>
			<td><span class="prb-lc-diff" style="color:${color}">${p.difficulty}</span></td>
			<td>${tags}</td>
			<td>${fileHtml}</td>`;
		return tr;
	}

	// ── Render dispatcher ────────────────────────────────────────
	function renderCF(query: string) {
		const results = searchCF(query, cfEntries);
		cfTbody.innerHTML = '';
		results.forEach((p) => cfTbody.appendChild(renderCFRow(p)));
		cfEmpty.hidden   = results.length > 0 || !query;
		countEl.textContent = query ? `${results.length} / ${cfEntries.length}` : `${cfEntries.length} problems`;
	}

	function renderLC(query: string) {
		const results = searchLC(query, lcEntries);
		lcTbody.innerHTML = '';
		results.forEach((p) => lcTbody.appendChild(renderLCRow(p)));
		lcEmpty.hidden   = results.length > 0 || !query;
		countEl.textContent = query ? `${results.length} / ${lcEntries.length}` : `${lcEntries.length} solved`;
	}

	function rerender() {
		const q = input.value;
		if (activeTab === 'cf') renderCF(q);
		else renderLC(q);
	}

	// ── Tab switching ────────────────────────────────────────────
	function switchTab(tab: 'cf' | 'lc') {
		activeTab = tab;
		tabCF.classList.toggle('prb-tab--active', tab === 'cf');
		tabLC.classList.toggle('prb-tab--active', tab === 'lc');
		tabCF.setAttribute('aria-selected', String(tab === 'cf'));
		tabLC.setAttribute('aria-selected', String(tab === 'lc'));
		cfPanel.hidden = tab !== 'cf';
		lcPanel.hidden = tab !== 'lc';
		input.value = '';
		input.placeholder = PLACEHOLDER[tab];
		rerender();
	}

	tabCF.addEventListener('click', () => switchTab('cf'));
	tabLC.addEventListener('click', () => switchTab('lc'));

	// ── Init ─────────────────────────────────────────────────────
	async function init() {
		loadingEl.hidden = false;
		errorEl.hidden   = true;
		cfPanel.hidden   = true;
		lcPanel.hidden   = true;
		input.placeholder = PLACEHOLDER.cf;

		try {
			[cfEntries, lcEntries] = await Promise.all([loadCF(), loadLC()]);
		} catch (e) {
			loadingEl.hidden = true;
			errorEl.hidden   = false;
			errorMsg.textContent = e instanceof Error ? e.message : 'Failed to load data.';
			return;
		}

		loadingEl.hidden = true;
		switchTab('cf');

		let timer: ReturnType<typeof setTimeout> | null = null;
		input.addEventListener('input', () => {
			if (timer) clearTimeout(timer);
			timer = setTimeout(rerender, 150);
		});
	}

	retryBtn.addEventListener('click', init);
	init();

	// ── Code viewer modal ────────────────────────────────────────
	const modal       = document.getElementById('code-modal')!   as HTMLElement;
	const backdrop    = document.getElementById('modal-backdrop')! as HTMLElement;
	const modalTitle  = document.getElementById('modal-title')!   as HTMLElement;
	const modalFname  = document.getElementById('modal-filename')! as HTMLElement;
	const modalGhLink = document.getElementById('modal-gh-link')!  as HTMLAnchorElement;
	const modalClose  = document.getElementById('modal-close')!   as HTMLButtonElement;
	const modalPicker = document.getElementById('modal-filepicker')! as HTMLElement;
	const modalList   = document.getElementById('modal-filelist')!  as HTMLElement;
	const modalLoad   = document.getElementById('modal-loading')!  as HTMLElement;
	const modalPre    = document.getElementById('modal-pre')!      as HTMLPreElement;
	const modalCode   = document.getElementById('modal-code')!     as HTMLElement;
	const modalErrEl  = document.getElementById('modal-err')!      as HTMLElement;

	const CF_RAW  = 'https://raw.githubusercontent.com/pelu10075/codeforces/main';
	const CF_API  = 'https://api.github.com/repos/pelu10075/codeforces/contents';
	const CF_TREE = 'https://github.com/pelu10075/codeforces/tree/main';
	const LC_RAW  = 'https://raw.githubusercontent.com/pelu10075/leetcode/main';
	const LC_BLOB = 'https://github.com/pelu10075/leetcode/blob/main';

	function openModal(title: string, ghHref: string) {
		modalTitle.textContent  = title;
		modalFname.textContent  = '';
		modalGhLink.href        = ghHref;
		modalPicker.hidden      = true;
		modalList.innerHTML     = '';
		modalLoad.hidden        = false;
		modalPre.hidden         = true;
		modalErrEl.hidden       = true;
		modal.hidden            = false;
		document.body.style.overflow = 'hidden';
	}

	function closeModal() {
		modal.hidden = true;
		document.body.style.overflow = '';
	}

	async function showRawFile(rawUrl: string, filename: string) {
		modalFname.textContent = filename;
		modalLoad.hidden  = false;
		modalPre.hidden   = true;
		modalErrEl.hidden = true;
		try {
			const res = await fetch(rawUrl);
			if (res.status === 404) {
				// 파일이 아직 레포에 없는 경우
				modalLoad.hidden  = true;
				modalErrEl.hidden = false;
				const isKo = document.documentElement.lang === 'ko'
					|| navigator.language.startsWith('ko');
				modalErrEl.innerHTML = isKo
					? '<span>아직 풀이 파일이 없습니다.</span>'
					: '<span>Solution file not found in repo yet.</span>';
				return;
			}
			if (!res.ok) throw new Error(`HTTP ${res.status}`);
			modalCode.textContent = await res.text();
			modalLoad.hidden = true;
			modalPre.hidden  = false;
		} catch {
			modalLoad.hidden  = true;
			modalErrEl.hidden = false;
		}
	}

	async function openCFFolder(id: string, folderPath: string) {
		openModal(id, `${CF_TREE}/${folderPath}`);
		try {
			const res = await fetch(`${CF_API}/${folderPath}`, {
				headers: { Accept: 'application/vnd.github+json', 'X-GitHub-Api-Version': '2022-11-28' },
			});
			if (!res.ok) throw new Error();
			const files = (await res.json()) as { name: string; type: string }[];
			const code  = files.filter((f) => f.type === 'file' && !/note\.md$/i.test(f.name));
			if (code.length === 0) throw new Error('no files');
			if (code.length === 1) {
				modalGhLink.href = `${CF_TREE}/${folderPath}`;
				await showRawFile(`${CF_RAW}/${folderPath}/${code[0].name}`, code[0].name);
			} else {
				modalLoad.hidden    = true;
				modalPicker.hidden  = false;
				code.forEach((f, i) => {
					const li  = document.createElement('li');
					const btn = document.createElement('button');
					btn.textContent = f.name;
					btn.addEventListener('click', async () => {
						modalList.querySelectorAll('button').forEach((b) => b.classList.remove('active'));
						btn.classList.add('active');
						modalGhLink.href = `${CF_TREE}/${folderPath}`;
						await showRawFile(`${CF_RAW}/${folderPath}/${f.name}`, f.name);
					});
					li.appendChild(btn);
					modalList.appendChild(li);
					if (i === 0) btn.click();
				});
			}
		} catch {
			modalLoad.hidden  = true;
			modalErrEl.hidden = false;
		}
	}

	async function openLCFile(id: string, filePath: string) {
		openModal(`LC #${id}`, `${LC_BLOB}/${filePath}`);
		await showRawFile(`${LC_RAW}/${filePath}`, filePath);
	}

	modalClose.addEventListener('click', closeModal);
	backdrop.addEventListener('click', closeModal);
	document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

	cfTbody.addEventListener('click', (e) => {
		const btn = (e.target as Element).closest('[data-cf-folder]') as HTMLElement | null;
		if (btn) openCFFolder(btn.dataset.cfId!, btn.dataset.cfFolder!);
	});
	lcTbody.addEventListener('click', (e) => {
		const btn = (e.target as Element).closest('[data-lc-file]') as HTMLElement | null;
		if (btn) openLCFile(btn.dataset.lcId!, btn.dataset.lcFile!);
	});
</script>
