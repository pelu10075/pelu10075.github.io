---
import BaseLayout from '../layouts/BaseLayout.astro';
import { REPO_URL } from '../lib/cfSearch';

const repoUrl = REPO_URL;
---

<BaseLayout title="Problems · pelu10075" description="Codeforces 문제 풀이 검색">
<main class="prb-main">

	<!-- ── Hero ─────────────────────────────────────────────── -->
	<header class="prb-hero">
		<nav class="prb-nav">
			<a href="/">← portfolio</a>
			<span class="prb-nav-sep">/</span>
			<a href="/problems">problems</a>
		</nav>
		<h1>Problems</h1>
		<p class="prb-subtitle">
			<span class="i18n i18n--en">All Codeforces submissions — solved status &amp; solution folder.</span>
			<span class="i18n i18n--ko">코드포스 제출 이력 — solved 여부 및 풀이 폴더를 확인합니다.</span>
		</p>
		<a href={repoUrl} target="_blank" rel="noopener noreferrer" class="prb-repo-btn">
			<svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
			</svg>
			pelu10075/codeforces
		</a>
	</header>

	<!-- ── Search bar ───────────────────────────────────────── -->
	<div class="search-bar">
		<input
			id="cf-search"
			type="text"
			placeholder="Search by ID, contest, tag…  e.g. 2220, A, 2220A, greedy"
			autocomplete="off"
			spellcheck="false"
		/>
		<span id="cf-count"></span>
	</div>

	<!-- ── Loading ──────────────────────────────────────────── -->
	<div id="cf-loading" class="prb-status">
		<span class="i18n i18n--en">Loading…</span>
		<span class="i18n i18n--ko">불러오는 중…</span>
	</div>

	<!-- ── Error ────────────────────────────────────────────── -->
	<div id="cf-error" class="prb-status prb-error" hidden>
		<span id="cf-error-msg"></span>
		<button id="cf-retry" class="prb-retry-btn">Retry</button>
	</div>

	<!-- ── Results table ────────────────────────────────────── -->
	<div id="cf-table-wrap" hidden>
		<table>
			<thead>
				<tr>
					<th>ID</th>
					<th><span class="i18n i18n--en">Title</span><span class="i18n i18n--ko">제목</span></th>
					<th><span class="i18n i18n--en">Tags</span><span class="i18n i18n--ko">태그</span></th>
					<th><span class="i18n i18n--en">Diff</span><span class="i18n i18n--ko">난이도</span></th>
					<th><span class="i18n i18n--en">Contest</span><span class="i18n i18n--ko">대회</span></th>
					<th>AC</th>
					<th><span class="i18n i18n--en">Folder</span><span class="i18n i18n--ko">폴더</span></th>
				</tr>
			</thead>
			<tbody id="cf-tbody"></tbody>
		</table>
		<p id="cf-no-results" class="prb-empty" hidden>
			<span class="i18n i18n--en">No matches.</span>
			<span class="i18n i18n--ko">결과 없음.</span>
		</p>
	</div>

</main>
</BaseLayout>

<!-- is:global — 동적으로 생성된 DOM 요소에도 스타일 적용 -->
<style is:global>
	/* ── Variables ───────────────────────────────────────────── */
	:root {
		--prb-mono:       'Space Mono', monospace;
		--prb-sans:       'Space Grotesk', sans-serif;
		--prb-bg:         #0d0d0d;
		--prb-text:       #f0f0f0;
		--prb-border:     #2a2a2a;
		--prb-tag-bg:     transparent;
		--prb-tag-border: #3a3a3a;
	}

	/* ── Layout ──────────────────────────────────────────────── */
	.prb-main {
		max-width: 960px;
		margin: 0 auto;
		padding: 2rem 1.5rem 6rem;
	}

	/* ── Hero ────────────────────────────────────────────────── */
	.prb-hero {
		padding: 2.5rem 0 2rem;
		border-bottom: 1px solid var(--prb-border);
	}

	.prb-nav {
		font-family: var(--prb-mono);
		font-size: 0.7rem;
		color: #555;
		display: flex;
		align-items: center;
		gap: 0.4rem;
		margin-bottom: 1.25rem;
		letter-spacing: 0.06em;
	}
	.prb-nav a { color: #888; text-decoration: none; transition: color 0.15s; }
	.prb-nav a:hover { color: var(--prb-text); }
	.prb-nav-sep { color: var(--prb-border); }

	.prb-hero h1 {
		font-size: clamp(1.9rem, 4vw, 2.8rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		margin: 0 0 0.6rem;
		color: var(--prb-text);
	}

	.prb-subtitle {
		font-size: 0.92rem;
		color: #888;
		margin: 0 0 1.25rem;
		line-height: 1.6;
	}

	.prb-repo-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-family: var(--prb-mono);
		font-size: 0.76rem;
		color: #888;
		text-decoration: none;
		padding: 0.4rem 0.85rem;
		border: 1px solid var(--prb-border);
		border-radius: 4px;
		transition: border-color 0.2s, color 0.2s;
	}
	.prb-repo-btn:hover { border-color: #555; color: var(--prb-text); }

	/* ── Search bar ──────────────────────────────────────────── */
	.search-bar {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		padding: 0.9rem 0;
		border-bottom: 1px solid var(--prb-border);
	}

	#cf-search {
		flex: 1;
		background: transparent;
		border: 1px solid var(--prb-border);
		border-radius: 4px;
		color: var(--prb-text);
		font-family: var(--prb-mono);
		font-size: 0.875rem;
		padding: 0.6rem 0.9rem;
		outline: none;
		transition: border-color 0.2s;
	}
	#cf-search:focus { border-color: #666; }
	#cf-search::placeholder { color: #444; }

	#cf-count {
		font-family: var(--prb-mono);
		font-size: 0.68rem;
		color: #555;
		white-space: nowrap;
		flex-shrink: 0;
	}

	/* ── Status ──────────────────────────────────────────────── */
	.prb-status {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 2.25rem 0;
		font-family: var(--prb-mono);
		font-size: 0.8rem;
		color: #555;
	}
	.prb-error { color: #cc4444; }
	.prb-retry-btn {
		font-family: var(--prb-mono);
		font-size: 0.72rem;
		background: transparent;
		border: 1px solid #cc4444;
		color: #cc4444;
		border-radius: 3px;
		padding: 0.25rem 0.65rem;
		cursor: pointer;
		transition: background 0.15s;
	}
	.prb-retry-btn:hover { background: rgba(204,68,68,0.12); }

	/* ── Table ───────────────────────────────────────────────── */
	.prb-main table {
		width: 100%;
		border-collapse: collapse;
		font-family: var(--prb-mono);
	}
	.prb-main th {
		font-size: 0.6rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: #555;
		font-weight: 400;
		padding: 0.5rem 0.85rem;
		text-align: left;
		border-bottom: 1px solid var(--prb-border);
		white-space: nowrap;
		background: #111;
	}
	.prb-main td {
		padding: 0.6rem 0.85rem;
		border-bottom: 1px solid var(--prb-border);
		vertical-align: middle;
		font-size: 0.84rem;
	}
	.prb-main tbody tr:last-child td { border-bottom: none; }
	.prb-main tbody tr { transition: background 0.1s; }
	.prb-main tbody tr:hover { background: #1a1a1a; }

	/* ── Problem ID ──────────────────────────────────────────── */
	.prb-id {
		font-family: var(--prb-mono);
		font-weight: 700;
		font-size: 0.88rem;
		letter-spacing: 0.05em;
	}
	.prb-id--solved { color: #f0f0f0; }
	.prb-id--unsolved { color: #555; }

	/* ── Title cell ──────────────────────────────────────────── */
	.prb-title-cell {
		font-size: 0.84rem;
		color: #aaa;
	}
	.prb-title-cell a {
		color: inherit;
		text-decoration: none;
		transition: color 0.15s;
	}
	.prb-title-cell a:hover { color: var(--prb-text); }

	/* ── Tags ────────────────────────────────────────────────── */
	.prb-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
		min-width: 0;
	}
	.prb-tag {
		display: inline-block;
		padding: 2px 7px;
		border: 1px solid var(--prb-tag-border);
		font-size: 0.7rem;
		font-family: var(--prb-mono);
		background: transparent;
		border-radius: 3px;
		color: #777;
		white-space: nowrap;
		line-height: 1.5;
	}

	/* ── Difficulty ──────────────────────────────────────────── */
	.prb-diff {
		font-family: var(--prb-mono);
		font-size: 0.8rem;
		font-weight: 700;
		white-space: nowrap;
	}

	/* ── Contest cell ────────────────────────────────────────── */
	.prb-contest-link {
		font-family: var(--prb-mono);
		font-size: 0.76rem;
		color: #666;
		text-decoration: none;
		white-space: nowrap;
		transition: color 0.15s;
	}
	.prb-contest-link:hover { color: #aaa; }

	/* ── AC status ───────────────────────────────────────────── */
	.prb-ac {
		font-family: var(--prb-mono);
		font-size: 0.78rem;
		font-weight: 700;
		color: #4caf50;
	}
	.prb-ac--no { color: #444; }

	/* ── Folder link ─────────────────────────────────────────── */
	.prb-folder-link {
		font-family: var(--prb-mono);
		font-size: 0.7rem;
		color: #666;
		text-decoration: none;
		padding: 0.15rem 0.45rem;
		border: 1px solid var(--prb-border);
		border-radius: 3px;
		transition: border-color 0.15s, color 0.15s;
		white-space: nowrap;
	}
	.prb-folder-link:hover { border-color: #555; color: var(--prb-text); }

	/* ── Empty ───────────────────────────────────────────────── */
	.prb-empty {
		padding: 1.5rem 0.85rem;
		font-family: var(--prb-mono);
		font-size: 0.8rem;
		color: #444;
		margin: 0;
	}

	/* ── Responsive ──────────────────────────────────────────── */
	@media (max-width: 760px) {
		/* Contest, AC 컬럼 숨김 */
		.prb-main td:nth-child(5),
		.prb-main th:nth-child(5),
		.prb-main td:nth-child(6),
		.prb-main th:nth-child(6) { display: none; }
	}
	@media (max-width: 540px) {
		/* Tags 컬럼도 숨김 */
		.prb-main td:nth-child(3),
		.prb-main th:nth-child(3) { display: none; }
	}
</style>

<script>
	import {
		loadEntries,
		performSearch,
		difficultyColor,
		TREE_BASE,
	} from '../lib/cfSearch';
	import type { ProblemEntry } from '../lib/cfSearch';

	// ── DOM refs ────────────────────────────────────────────────
	const input     = document.getElementById('cf-search')      as HTMLInputElement;
	const countEl   = document.getElementById('cf-count')       as HTMLElement;
	const loadingEl = document.getElementById('cf-loading')     as HTMLElement;
	const errorEl   = document.getElementById('cf-error')       as HTMLElement;
	const errorMsg  = document.getElementById('cf-error-msg')   as HTMLElement;
	const retryBtn  = document.getElementById('cf-retry')       as HTMLButtonElement;
	const tableWrap = document.getElementById('cf-table-wrap')  as HTMLElement;
	const tbody     = document.getElementById('cf-tbody')       as HTMLTableSectionElement;
	const noResults = document.getElementById('cf-no-results')  as HTMLElement;

	// ── Render ──────────────────────────────────────────────────

	function renderRow(p: ProblemEntry): HTMLTableRowElement {
		const tr    = document.createElement('tr');
		const color = difficultyColor(p.difficulty);

		const cfUrl     = `https://codeforces.com/contest/${p.contestId}/problem/${p.id.replace(/^\d+/, '')}`;
		const contestUrl = `https://codeforces.com/contest/${p.contestId}`;
		const folderUrl  = p.folderPath ? `${TREE_BASE}/${p.folderPath}` : null;

		// ID
		const idClass = p.solved ? 'prb-id prb-id--solved' : 'prb-id prb-id--unsolved';

		// Tags — 개별 chip으로 렌더
		const tagsHtml = p.tags.length
			? `<div class="prb-tags">${p.tags.map((t) => `<span class="prb-tag">${t}</span>`).join('')}</div>`
			: '<span style="color:#444">—</span>';

		// Difficulty
		const diffHtml = p.difficulty
			? `<span class="prb-diff" style="color:${color}">*${p.difficulty}</span>`
			: `<span class="prb-diff" style="color:#808080">?</span>`;

		// AC badge
		const acHtml = p.solved
			? `<span class="prb-ac">✓</span>`
			: `<span class="prb-ac prb-ac--no">—</span>`;

		// Folder link
		const folderHtml = folderUrl
			? `<a href="${folderUrl}" target="_blank" rel="noopener noreferrer" class="prb-folder-link">${p.id}/</a>`
			: `<span style="color:#333">—</span>`;

		tr.innerHTML = `
			<td><span class="${idClass}">${p.id}</span></td>
			<td class="prb-title-cell">
				<a href="${cfUrl}" target="_blank" rel="noopener noreferrer">${p.title || p.id}</a>
			</td>
			<td>${tagsHtml}</td>
			<td>${diffHtml}</td>
			<td><a href="${contestUrl}" target="_blank" rel="noopener noreferrer" class="prb-contest-link">#${p.contestId}</a></td>
			<td>${acHtml}</td>
			<td>${folderHtml}</td>
		`;
		return tr;
	}

	function render(entries: ProblemEntry[], query: string) {
		const results = performSearch(query, entries);
		countEl.textContent = query
			? `${results.length} / ${entries.length}`
			: `${entries.length} problems`;

		tbody.innerHTML = '';
		results.forEach((p) => tbody.appendChild(renderRow(p)));
		noResults.hidden = results.length > 0 || !query;
		tableWrap.hidden = false;
	}

	// ── Init ────────────────────────────────────────────────────

	async function init() {
		loadingEl.hidden = false;
		errorEl.hidden   = true;
		tableWrap.hidden = true;

		let entries: ProblemEntry[];
		try {
			entries = await loadEntries();
		} catch (e) {
			loadingEl.hidden = true;
			errorEl.hidden   = false;
			errorMsg.textContent = e instanceof Error ? e.message : 'Failed to load data.';
			return;
		}

		loadingEl.hidden = true;
		render(entries, '');

		let timer: ReturnType<typeof setTimeout> | null = null;
		input.addEventListener('input', () => {
			if (timer) clearTimeout(timer);
			timer = setTimeout(() => render(entries, input.value), 150);
		});
	}

	retryBtn.addEventListener('click', init);
	init();
</script>
