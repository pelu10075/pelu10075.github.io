---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactIcon from '../components/ContactIcon.astro';
import { getCollection } from 'astro:content';
import {
	siteMeta,
	hero,
	about,
	skillsSection,
	projectsSection,
	competitive,
	blogSection,
	contactSection,
	revealDelays,
	projectTitleSpans,
} from '../config/site';

const blogPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

function formatBlogDate(d: Date) {
	return new Intl.DateTimeFormat('en-CA', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
	}).format(d);
}

const ghIconPath =
	'M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z';
---

<BaseLayout title={siteMeta.title} description={siteMeta.description} fullWidth>
	<section id="hero" class="hero" aria-label="Introduction">
		<div class="hero-grid" aria-hidden="true"></div>
		<div class="hero-inner">
			<div class="hero-tag">
				<span class="i18n i18n--en">{hero.tagline.en}</span>
				<span class="i18n i18n--ko">{hero.tagline.ko}</span>
			</div>
			<h1 class="hero-name">{hero.name}</h1>
			<div class="hero-name-kr">{hero.nameKr}</div>
			<p class="hero-desc i18n i18n--en" set:html={hero.introHtml.en} />
			<p class="hero-desc i18n i18n--ko" set:html={hero.introHtml.ko} />
			<div class="hero-btns">
				<a href={hero.githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
						><path d={ghIconPath}></path></svg
					>
					GitHub
				</a>
				<a href="#contact" class="btn btn-secondary">
					<span class="i18n i18n--en">{hero.contactCta.en}</span>
					<span class="i18n i18n--ko">{hero.contactCta.ko}</span>
				</a>
			</div>
		</div>
		<div class="hero-scroll" aria-hidden="true">
			<span class="i18n i18n--en">{hero.scrollLabel.en}</span>
			<span class="i18n i18n--ko">{hero.scrollLabel.ko}</span>
		</div>
	</section>

	<section id="about" class="band">
		<div class="section-inner">
			<div class="section-label" data-num="01">
				<span class="i18n i18n--en">{about.sectionLabel.en}</span>
				<span class="i18n i18n--ko">{about.sectionLabel.ko}</span>
			</div>
			<h2 class="section-title reveal">
				<span class="i18n i18n--en">{about.title.en}</span>
				<span class="i18n i18n--ko">{about.title.ko}</span>
			</h2>
			<div class="about-grid">
				<div class="about-text reveal reveal-delay-1">
					{
						about.paragraphsHtml.map((para) => (
							<>
								<p class="i18n i18n--en" set:html={para.en} />
								<p class="i18n i18n--ko" set:html={para.ko} />
							</>
						))
					}
				</div>
				<div class="about-stats reveal reveal-delay-2">
					{
						about.stats.map((s) => (
							<div class="stat-card">
								<div class="stat-num">{s.value}</div>
								<div class="stat-label i18n i18n--en">{s.label.en}</div>
								<div class="stat-label i18n i18n--ko">{s.label.ko}</div>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<section id="skills">
		<div class="section-inner">
			<div class="section-label" data-num="02">
				<span class="i18n i18n--en">{skillsSection.sectionLabel.en}</span>
				<span class="i18n i18n--ko">{skillsSection.sectionLabel.ko}</span>
			</div>
			<h2 class="section-title reveal">
				<span class="i18n i18n--en">{skillsSection.title.en}</span>
				<span class="i18n i18n--ko">{skillsSection.title.ko}</span>
			</h2>
			<div class="skills-grid">
				{
					skillsSection.items.map((skill, i) => (
						<div class:list={['skill-card', 'reveal', `reveal-delay-${revealDelays[i % 4]}`]}>
							<div class="skill-icon">{skill.icon}</div>
							<div class="skill-name">{skill.name}</div>
							<div class="skill-desc i18n i18n--en">{skill.description.en}</div>
							<div class="skill-desc i18n i18n--ko">{skill.description.ko}</div>
							<div class="skill-tags">
								{skill.tags.map((t) => (
									<span class="tag">{t}</span>
								))}
							</div>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section id="projects" class="band">
		<div class="section-inner">
			<div class="section-label" data-num="03">
				<span class="i18n i18n--en">{projectsSection.sectionLabel.en}</span>
				<span class="i18n i18n--ko">{projectsSection.sectionLabel.ko}</span>
			</div>
			<h2 class="section-title reveal">
				<span class="i18n i18n--en">{projectsSection.title.en}</span>
				<span class="i18n i18n--ko">{projectsSection.title.ko}</span>
			</h2>
			<div class="projects-grid">
				{
					projectsSection.items.map((proj, i) => {
						const num = String(i + 1).padStart(2, '0');
						const delay = revealDelays[i % 4];
						const pt = projectTitleSpans(proj.title);
						return (
							<div class:list={['project-card', 'reveal', `reveal-delay-${delay}`]}>
								<div class="project-num">{num}</div>
								<div class="project-title">
									{pt.mode === 'single' ? (
										<span class="project-title-text">{pt.text}</span>
									) : (
										<span class="project-title-text">
											<span class="i18n i18n--en">{pt.title.en}</span>
											<span class="i18n i18n--ko">{pt.title.ko}</span>
										</span>
									)}
									<span class="project-arrow">↗</span>
								</div>
								<div class="project-desc i18n i18n--en" set:html={proj.description.en} />
								<div class="project-desc i18n i18n--ko" set:html={proj.description.ko} />
								<div class="project-footer">
									<a href={proj.sourceUrl} target="_blank" rel="noopener noreferrer" class="project-link">
										<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
											<path d={ghIconPath} />
										</svg>
										<span class="i18n i18n--en">{projectsSection.viewSource.en}</span>
										<span class="i18n i18n--ko">{projectsSection.viewSource.ko}</span>
									</a>
									{proj.tags.map((t) => (
										<span class="tag">{t}</span>
									))}
								</div>
							</div>
						);
					})
				}
			</div>
		</div>
	</section>

	<section id="competitive">
		<div class="section-inner">
			<div class="section-label" data-num="04">
				<span class="i18n i18n--en">{competitive.sectionLabel.en}</span>
				<span class="i18n i18n--ko">{competitive.sectionLabel.ko}</span>
			</div>
			<h2 class="section-title reveal">
				<span class="i18n i18n--en">{competitive.title.en}</span>
				<span class="i18n i18n--ko">{competitive.title.ko}</span>
			</h2>
			<div class="cp-layout">
				<div class="cp-text reveal reveal-delay-1">
					{
						competitive.paragraphsHtml.map((para) => (
							<>
								<p class="i18n i18n--en" set:html={para.en} />
								<p class="i18n i18n--ko" set:html={para.ko} />
							</>
						))
					}
					<div class="cp-actions">
						<a
							href={competitive.badge.profileUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="cp-link"
						>
							<span class="i18n i18n--en">{competitive.profileLinkLabel.en}</span>
							<span class="i18n i18n--ko">{competitive.profileLinkLabel.ko}</span>
						</a>
					</div>
				</div>
				<div class="cp-badge-wrap reveal reveal-delay-2">
					<img
						src={competitive.badge.imageUrl}
						alt={competitive.badge.alt}
						width="320"
						height="160"
						loading="lazy"
					/>
					<div class="cp-badge-foot">
						<a
							href={competitive.badge.profileUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="cp-link"
						>
							{competitive.badge.handle}
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section id="blog" class="band blog-band">
		<div class="section-inner">
			<div class="section-label" data-num="05">
				<span class="i18n i18n--en">{blogSection.sectionLabel.en}</span>
				<span class="i18n i18n--ko">{blogSection.sectionLabel.ko}</span>
			</div>
			<h2 class="section-title reveal">
				<span class="i18n i18n--en">{blogSection.title.en}</span>
				<span class="i18n i18n--ko">{blogSection.title.ko}</span>
			</h2>
			<div class="blog-preview-list">
				{
					blogPosts.length === 0 ? (
						<div class="blog-empty">
							<a href="/blog/">
								<span class="i18n i18n--en">{blogSection.empty.en}</span>
								<span class="i18n i18n--ko">{blogSection.empty.ko}</span>
							</a>
						</div>
					) : (
						blogPosts.map((post) => (
							<a href={`/blog/${post.id}/`} class="blog-preview-card">
								<div class="blog-preview-meta">
									{formatBlogDate(post.data.pubDate)}
									{post.data.tags?.[0] && ` · ${post.data.tags[0]}`}
								</div>
								<div class="blog-preview-title">{post.data.title}</div>
								<div class="blog-preview-excerpt">{post.data.description}</div>
							</a>
						))
					)
				}
			</div>
			<div class="blog-more">
				<a href="/blog/" class="btn btn-secondary">
					<span class="i18n i18n--en">{blogSection.allPosts.en}</span>
					<span class="i18n i18n--ko">{blogSection.allPosts.ko}</span>
				</a>
			</div>
		</div>
	</section>

	<section id="contact" class="band">
		<div class="section-inner">
			<div class="section-label" data-num="06">
				<span class="i18n i18n--en">{contactSection.sectionLabel.en}</span>
				<span class="i18n i18n--ko">{contactSection.sectionLabel.ko}</span>
			</div>
			<div class="contact-inner">
				<div class="contact-heading reveal">
					<span class="contact-heading-line1 i18n i18n--en">{contactSection.headingLine1.en}</span>
					<span class="contact-heading-line1 i18n i18n--ko">{contactSection.headingLine1.ko}</span>
					<br />
					<span class="contact-heading-line2 i18n i18n--en" set:html={contactSection.headingLine2.en} />
					<span class="contact-heading-line2 i18n i18n--ko" set:html={contactSection.headingLine2.ko} />
				</div>
				<div class="contact-links reveal reveal-delay-1">
					{
						contactSection.links.map((link) => (
							<a
								href={link.href}
								class="contact-link"
								target={link.href.startsWith('http') ? '_blank' : undefined}
								rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
							>
								<ContactIcon name={link.icon} />
								{link.label}
							</a>
						))
					}
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		min-height: 100vh;
		display: flex;
		align-items: center;
		padding: 0 2.5rem;
		position: relative;
		overflow: hidden;
	}

	.hero-grid {
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(var(--border) 1px, transparent 1px),
			linear-gradient(90deg, var(--border) 1px, transparent 1px);
		background-size: 60px 60px;
		opacity: 0.3;
		mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 40%, transparent 100%);
	}

	.hero-inner {
		position: relative;
		max-width: 900px;
	}

	.hero-tag {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--text-dim);
		letter-spacing: 0.2em;
		text-transform: uppercase;
		margin-bottom: 1.5rem;
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.hero-tag::before {
		content: '';
		width: 32px;
		height: 1px;
		background: var(--text-dim);
	}

	.hero-name {
		font-size: clamp(3rem, 8vw, 6.5rem);
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.03em;
		margin: 0 0 0.25rem;
	}

	.hero-name-kr {
		font-size: clamp(1.2rem, 3vw, 2rem);
		font-weight: 300;
		color: var(--text-muted);
		letter-spacing: 0.1em;
		margin-bottom: 2rem;
	}

	.hero-desc {
		font-size: clamp(1rem, 2vw, 1.2rem);
		color: var(--text-muted);
		max-width: 540px;
		margin: 0 0 3rem;
		font-weight: 300;
		line-height: 1.8;
	}

	.hero-desc strong {
		color: var(--text);
		font-weight: 500;
	}

	.hero-btns {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem 1.5rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		letter-spacing: 0.05em;
		text-decoration: none;
		border-radius: 4px;
		transition: all 0.2s;
		cursor: pointer;
		border: 1px solid transparent;
	}

	.btn-primary {
		background: var(--accent);
		color: var(--bg);
		border-color: var(--accent);
	}

	.btn-primary:hover {
		background: transparent;
		color: var(--accent);
	}

	.btn-secondary {
		background: transparent;
		color: var(--text-muted);
		border-color: var(--border);
	}

	.btn-secondary:hover {
		border-color: var(--text-muted);
		color: var(--text);
	}

	.hero-scroll {
		position: absolute;
		bottom: 3rem;
		left: 2.5rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--text-dim);
		letter-spacing: 0.15em;
		writing-mode: vertical-rl;
		text-orientation: mixed;
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.hero-scroll::after {
		content: '';
		width: 1px;
		height: 40px;
		background: linear-gradient(to bottom, var(--text-dim), transparent);
	}

	.band {
		background: var(--bg2);
	}

	section:not(.hero) {
		padding: 6rem 2.5rem;
	}

	.section-inner {
		max-width: 960px;
		margin: 0 auto;
	}

	.section-label {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--text-dim);
		letter-spacing: 0.25em;
		text-transform: uppercase;
		margin-bottom: 0.75rem;
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.section-label::before {
		content: attr(data-num);
		color: var(--text-dim);
	}

	.section-title {
		font-size: clamp(2rem, 5vw, 3.2rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		margin: 0 0 3rem;
		line-height: 1.1;
	}

	.about-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;
		align-items: start;
	}

	.about-text p {
		color: var(--text-muted);
		font-size: 1.05rem;
		line-height: 1.9;
		margin: 0 0 1.25rem;
		font-weight: 300;
	}

	.about-text strong {
		color: var(--text);
		font-weight: 500;
	}

	.about-stats {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1px;
		background: var(--border);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
	}

	.stat-card {
		background: var(--bg2);
		padding: 1.75rem;
	}

	.stat-num {
		font-family: var(--font-mono);
		font-size: 2rem;
		font-weight: 700;
		color: var(--accent);
		margin-bottom: 0.25rem;
	}

	.stat-label {
		font-size: 0.8rem;
		color: var(--text-dim);
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}

	.skills-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1px;
		background: var(--border);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
	}

	.skill-card {
		background: var(--bg);
		padding: 2rem 1.75rem;
		transition: background 0.2s;
	}

	.skill-card:hover {
		background: var(--bg3);
	}

	.skill-icon {
		font-family: var(--font-mono);
		font-size: 1.5rem;
		margin-bottom: 1rem;
		color: var(--text-muted);
	}

	.skill-name {
		font-size: 1.05rem;
		font-weight: 600;
		margin-bottom: 0.5rem;
	}

	.skill-desc {
		font-size: 0.85rem;
		color: var(--text-dim);
		line-height: 1.6;
		margin-bottom: 1rem;
	}

	.skill-tags,
	.project-footer {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.tag {
		font-family: var(--font-mono);
		font-size: 0.65rem;
		padding: 0.2rem 0.5rem;
		border: 1px solid var(--border);
		border-radius: 3px;
		color: var(--text-dim);
		letter-spacing: 0.05em;
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1px;
		background: var(--border);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
	}

	.project-card {
		background: var(--bg2);
		padding: 2rem;
		display: flex;
		flex-direction: column;
		transition: background 0.2s;
		position: relative;
	}

	.project-card:hover {
		background: var(--bg3);
	}

	.project-card:hover .project-arrow {
		opacity: 1;
		transform: translate(2px, -2px);
	}

	.project-num {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--text-dim);
		margin-bottom: 1.5rem;
	}

	.project-title {
		font-size: 1.15rem;
		font-weight: 600;
		margin-bottom: 0.75rem;
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.project-arrow {
		font-size: 1rem;
		color: var(--text-dim);
		flex-shrink: 0;
		opacity: 0;
		transition: all 0.2s;
	}

	.project-desc {
		font-size: 0.88rem;
		color: var(--text-dim);
		line-height: 1.7;
		flex: 1;
		margin-bottom: 1.5rem;
	}

	.project-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--text-muted);
		text-decoration: none;
		padding: 0.3rem 0.6rem;
		border: 1px solid var(--border);
		border-radius: 3px;
		transition: all 0.2s;
		letter-spacing: 0.05em;
	}

	.project-link:hover {
		border-color: var(--text-muted);
		color: var(--text);
	}

	.cp-layout {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 3rem;
		align-items: start;
	}

	.cp-text p {
		color: var(--text-muted);
		font-size: 1rem;
		line-height: 1.9;
		margin: 0 0 1rem;
		font-weight: 300;
	}

	.cp-actions {
		margin-top: 1.5rem;
	}

	.cp-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
