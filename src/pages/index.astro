<script>
	function initHome() {
		const heroInner = document.querySelector('.hero-inner');
		if (heroInner instanceof HTMLElement) {
			heroInner.style.opacity = '0';
			heroInner.style.transform = 'translateY(20px)';
			requestAnimationFrame(() => {
				setTimeout(() => {
					heroInner.style.transition = 'opacity 0.9s ease, transform 0.9s ease';
					heroInner.style.opacity = '1';
					heroInner.style.transform = 'translateY(0)';
				}, 100);
			});
		}

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((e) => {
					if (e.isIntersecting) e.target.classList.add('visible');
				});
			},
			{ threshold: 0.1 },
		);
		document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

		const filterButtons = Array.from(
			document.querySelectorAll<HTMLButtonElement>('[data-project-filter-btn]'),
		);
		const projectCards = Array.from(
			document.querySelectorAll<HTMLElement>('[data-project-filter-item]'),
		);
		const applyFilter = (filter: string) => {
			filterButtons.forEach((btn) => btn.classList.toggle('is-active', btn.dataset.filter === filter));
			projectCards.forEach((card) => {
				const category = card.dataset.category;
				const show = filter === 'All' || category === filter;
				card.style.display = show ? '' : 'none';
			});
		};
		filterButtons.forEach((btn) => {
			btn.addEventListener('click', () => applyFilter(btn.dataset.filter || 'All'));
		});

	}

	initHome();
	document.addEventListener('astro:page-load', initHome);
</script>
