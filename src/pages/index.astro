---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactIcon from '../components/ContactIcon.astro';
import { getCollection } from 'astro:content';
import {
	siteMeta,
	hero,
	about,
	skillsSection,
	projectsSection,
	projectShowcase,
	activitySection,
	competitive,
	codeforcesSolutionsSection,
	blogSection,
	contactSection,
	revealDelays,
	projectTitleSpans,
	integrations,
} from '../config/site';
import type { ProjectEntry } from '../config/site';
import {
	fetchGitHubUser,
	fetchGitHubRepos,
	fetchCodeforcesUser,
	fetchLeetCodeUser,
	type GitHubRepo,
} from '../lib/profileApis';

const blogPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

function formatBlogDate(d: Date) {
	return new Intl.DateTimeFormat('en-CA', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
	}).format(d);
}

const ghIconPath =
	'M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z';

const [ghUser, ghRepos, cfUser, lcUser] = await Promise.all([
	fetchGitHubUser(integrations.githubLogin),
	fetchGitHubRepos(integrations.githubLogin, integrations.githubReposLimit),
	fetchCodeforcesUser(integrations.codeforcesHandle),
	fetchLeetCodeUser('edward_10'),
]);

const githubProfileUrl = ghUser?.html_url ?? hero.githubUrl;

type ProjectCard = ProjectEntry & {
	repoName: string;
	isFeatured: boolean;
	category: string;
	stars: number | null;
	updatedAt: string | null;
	updatedRelative: string | null;
};

function repoNameFromUrl(url: string) {
	try {
		const u = new URL(url);
		const seg = u.pathname.split('/').filter(Boolean);
		return seg[1] ?? '';
	} catch {
		return '';
	}
}

function relativeUpdated(iso: string | null) {
	if (!iso) return null;
	const t = Date.parse(iso);
	if (Number.isNaN(t)) return null;
	const diffMs = Date.now() - t;
	const dayMs = 24 * 60 * 60 * 1000;
	const days = Math.max(1, Math.floor(diffMs / dayMs));
	if (days < 7) return `${days}d ago`;
	const weeks = Math.floor(days / 7);
	if (weeks < 5) return `${weeks}w ago`;
	const months = Math.floor(days / 30);
	if (months < 12) return `${months}mo ago`;
	const years = Math.floor(days / 365);
	return `${years}y ago`;
}

function categoryFromRepo(repoName: string, tags: string[]) {
	const manual = projectShowcase.manualCategories[repoName];
	if (manual) return manual;
	const normalized = tags.map((t) => t.toLowerCase());
	if (normalized.some((t) => ['astro', 'react', 'next.js', 'html', 'css'].includes(t))) return 'Web';
	if (normalized.some((t) => ['cryptography', 'crypto'].includes(t))) return 'Crypto';
	if (normalized.some((t) => ['algorithms', 'algo', 'competitive'].includes(t))) return 'Algo';
	if (normalized.some((t) => ['fastapi', 'api', 'backend', 'python'].includes(t))) return 'Backend';
	return projectShowcase.defaultCategory;
}

function reposToProjects(repos: GitHubRepo[]): ProjectEntry[] {
	return repos.map((repo) => {
		const desc = repo.description?.trim();
		const fallbackEn = 'No description.';
		const fallbackKo = '설명이 없습니다.';
		const tags = [repo.language, ...repo.topics.slice(0, 3)].filter(Boolean) as string[];
		return {
			title: repo.name,
			description: {
				en: desc || fallbackEn,
				ko: desc || fallbackKo,
			},
			sourceUrl: repo.html_url,
			tags: tags.length ? tags.slice(0, 4) : ['GitHub'],
		};
	});
}

function toProjectCard(item: ProjectEntry, sourceRepo?: GitHubRepo): ProjectCard {
	const repoName = sourceRepo?.name ?? repoNameFromUrl(item.sourceUrl);
	const featuredSet = new Set(projectShowcase.featuredRepoNames);
	return {
		...item,
		repoName,
		isFeatured: featuredSet.has(repoName),
		category: categoryFromRepo(repoName, item.tags),
		stars: sourceRepo?.stargazers_count ?? null,
		updatedAt: sourceRepo?.updated_at ?? null,
		updatedRelative: relativeUpdated(sourceRepo?.updated_at ?? null),
	};
}

const hiddenSet = new Set(projectShowcase.hiddenRepoNames);
const githubRepoByName = new Map(ghRepos.map((repo) => [repo.name, repo]));
const rankedGithubRepos = ghRepos
	.filter((repo) => !hiddenSet.has(repo.name))
	.sort((a, b) => {
		const af = projectShowcase.featuredRepoNames.includes(a.name) ? 1 : 0;
		const bf = projectShowcase.featuredRepoNames.includes(b.name) ? 1 : 0;
		if (af !== bf) return bf - af;
		return Date.parse(b.updated_at) - Date.parse(a.updated_at);
	});

let projectCards: ProjectCard[] = projectsSection.items
	.map((item) => {
		const repoName = repoNameFromUrl(item.sourceUrl);
		const sourceRepo = githubRepoByName.get(repoName);
		return toProjectCard(item, sourceRepo);
	})
	.filter((item) => !hiddenSet.has(item.repoName));
if (integrations.projectsFromGitHub && rankedGithubRepos.length > 0) {
	projectCards = reposToProjects(rankedGithubRepos).map((item, idx) => toProjectCard(item, rankedGithubRepos[idx]));
}

const dynamicActivity = rankedGithubRepos.slice(0, 2).map((repo) => ({
	month: repo.updated_at.slice(0, 7),
	title: { en: `Updated ${repo.name}`, ko: `${repo.name} 업데이트` },
	detail: {
		en: repo.description?.trim() || 'Latest project update synced from GitHub.',
		ko: repo.description?.trim() || 'GitHub 기준 최근 프로젝트 업데이트를 동기화했습니다.',
	},
	link: repo.html_url,
}));
const activityItems = [...dynamicActivity, ...activitySection.items];

const aboutStats = about.stats.map((s) => {
	const isRepoStat = s.label.en === 'GitHub Repos' || s.label.ko === 'GitHub 저장소';
	if (isRepoStat && ghUser) {
		return { ...s, value: String(ghUser.public_repos) };
	}
	return s;
});

const contactLinksResolved = contactSection.links.map((link) => {
	if (link.icon === 'github' && ghUser) {
		return {
			...link,
			href: ghUser.html_url,
			label: ghUser.html_url.replace(/^https?:\/\//, ''),
		};
	}
	return link;
});
---

<BaseLayout title={siteMeta.title} description={siteMeta.description} fullWidth>
	<section id="hero" class="hero" aria-label="Introduction">
		<div class="hero-grid" aria-hidden="true"></div>
		<div class="hero-inner">
			<div class="hero-tag">
				<span class="i18n i18n--en">{hero.tagline.en}</span>
				<span class="i18n i18n--ko">{hero.tagline.ko}</span>
			</div>
			<h1 class="hero-name">{hero.name}</h1>
			<div class="hero-name-kr">{hero.nameKr}</div>
			<p class="hero-desc i18n i18n--en" set:html={hero.introHtml.en} />
			<p class="hero-desc i18n i18n--ko" set:html={hero.introHtml.ko} />
			<div class="hero-btns">
				<a href={githubProfileUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
						><path d={ghIconPath}></path></svg
					>
					GitHub
				</a>
				<a href="#contact" class="btn btn-secondary">
					<span class="i18n i18n--en">{hero.contactCta.en}</span>
					<span class="i18n i18n--ko">{hero.contactCta.ko}</span>
				</a>
			</div>
		</div>
		<div class="hero-scroll" aria-hidden="true">
			<span class="i18n i18n--en">{hero.scrollLabel.en}</span>
			<span class="i18n i18n--ko">{hero.scrollLabel.ko}</span>
		</div>
	</section>

	<section id="about" class="band">
		<div class="section-inner">
			<div class="section-label" data-num="01">
				<span class="i18n i18n--en">{about.sectionLabel.en}</span>
				<span class="i18n i18n--ko">{about.sectionLabel.ko}</span>
			</div>
			<h2 class="section-title reveal">
				<span class="i18n i18n--en">{about.title.en}</span>
				<span class="i18n i18n--ko">{about.title.ko}</span>
			</h2>
			<div class="about-grid">
				<div class="about-text reveal reveal-delay-1">
					{
						about.paragraphsHtml.map((para) => (
							<>
								<p class="i18n i18n--en" set:html={para.en} />
								<p class="i18n i18n--ko" set:html={para.ko} />
							</>
						))
					}
				</div>
				<div class="about-stats reveal reveal-delay-2">
					{
						aboutStats.map((s) => (
							<div class="stat-card">
								<div class="stat-num">{s.value}</div>
								<div class="stat-label i18n i18n--en">{s.label.en}</div>
								<div class="stat-label i18n i18n--ko">{s.label.ko}</div>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<section id="skills" class="band">
		<div class="section-inner">
			<div class="section-label" data-num="02">
				<span class="i18n i18n--en">{skillsSection.sectionLabel.en}</span>
				<span class="i18n i18n--ko">{skillsSection.sectionLabel.ko}</span>
			</div>
			<h2 class="section-title reveal">
				<span class="i18n i18n--en">{skillsSection.title.en}</span>
				<span class="i18n i18n--ko">{skillsSection.title.ko}</span>
			</h2>
			<div class="skills-grid">
				{
					skillsSection.items.map((skill, i) => (
						<div class:list={['skill-card', 'reveal', `reveal-delay-${revealDelays[i % 4]}`]}>
							<div class="skill-icon">{skill.icon}</div>
							<div class="skill-name">{skill.name}</div>
							<div class="skill-desc i18n i18n--en">{skill.description.en}</div>
							<div class="skill-desc i18n i18n--ko">{skill.description.ko}</div>
							<div class="skill-tags">
								{skill.tags.map((t) => (
									<span class="tag">{t}</span>
								))}
							</div>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section id="competitive" class="band">
		<div class="section-inner">
			<div class="section-label" data-num="03">
				<span class="i18n i18n--en">{competitive.sectionLabel.en}</span>
				<span class="i18n i18n--ko">{competitive.sectionLabel.ko}</span>
			</div>
			<h2 class="section-title reveal">
				<span class="i18n i18n--en">{competitive.title.en}</span>
				<span class="i18n i18n--ko">{competitive.title.ko}</span>
			</h2>

			<!-- ── Stats cards ──────────────────────────────────── -->
			<div class="cp-layout">
				<div class="cp-text reveal reveal-delay-1">
					{
						competitive.paragraphsHtml.map((para) => (
							<>
								<p class="i18n i18n--en" set:html={para.en} />
								<p class="i18n i18n--ko" set:html={para.ko} />
							</>
						))
					}
					<div class="cp-actions cp-actions-row">
						<a
							href={competitive.codeforces.profileUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="cp-link"
						>
							<span class="i18n i18n--en">{competitive.codeforces.linkLabel.en}</span>
							<span class="i18n i18n--ko">{competitive.codeforces.linkLabel.ko}</span>
						</a>
						<a
							href={competitive.badge.profileUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="cp-link"
						>
							<span class="i18n i18n--en">{competitive.profileLinkLabel.en}</span>
							<span class="i18n i18n--ko">{competitive.profileLinkLabel.ko}</span>
						</a>
					</div>
				</div>
				<div class="cp-badges-column reveal reveal-delay-2">
					<div class="cf-card">
						<div class="cf-card-title">Codeforces</div>
						<div class="cf-handle">{integrations.codeforcesHandle}</div>
						{
							cfUser ? (
								<dl class="cf-stats">
									<div class="cf-stat">
										<dt>
											<span class="i18n i18n--en">{competitive.codeforces.labels.rating.en}</span>
											<span class="i18n i18n--ko">{competitive.codeforces.labels.rating.ko}</span>
										</dt>
										<dd>
											{cfUser.rating != null ? cfUser.rating : (
												<>
													<span class="i18n i18n--en">{competitive.codeforces.labels.unrated.en}</span>
													<span class="i18n i18n--ko">{competitive.codeforces.labels.unrated.ko}</span>
												</>
											)}
										</dd>
									</div>
									<div class="cf-stat">
										<dt>
											<span class="i18n i18n--en">{competitive.codeforces.labels.maxRating.en}</span>
											<span class="i18n i18n--ko">{competitive.codeforces.labels.maxRating.ko}</span>
										</dt>
										<dd>{cfUser.maxRating ?? '—'}</dd>
									</div>
									<div class="cf-stat">
										<dt>
											<span class="i18n i18n--en">{competitive.codeforces.labels.rank.en}</span>
											<span class="i18n i18n--ko">{competitive.codeforces.labels.rank.ko}</span>
										</dt>
										<dd>{cfUser.rank ?? cfUser.maxRank ?? '—'}</dd>
									</div>
								</dl>
							) : (
								<>
									<p class="cf-unavailable i18n i18n--en">Could not load Codeforces profile.</p>
									<p class="cf-unavailable i18n i18n--ko">Codeforces 프로필을 불러오지 못했습니다.</p>
								</>
							)
						}
						<a
							href={competitive.codeforces.profileUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="cp-link cf-card-link"
						>
							codeforces.com/profile/{integrations.codeforcesHandle}
						</a>
					</div>
					<div class="cf-card">
						<div class="cf-card-title">LeetCode</div>
						<div class="cf-handle">edward_10</div>
						{
							lcUser ? (
								<dl class="cf-stats">
									<div class="cf-stat">
										<dt><span class="i18n i18n--en">{competitive.leetcode.labels.total.en}</span><span class="i18n i18n--ko">{competitive.leetcode.labels.total.ko}</span></dt>
										<dd>{lcUser.totalSolved}</dd>
									</div>
									<div class="cf-stat">
										<dt style="color:#00b8a3">{competitive.leetcode.labels.easy.en}</dt>
										<dd style="color:#00b8a3">{lcUser.easySolved}</dd>
									</div>
									<div class="cf-stat">
										<dt style="color:#ffc01e">{competitive.leetcode.labels.medium.en}</dt>
										<dd style="color:#ffc01e">{lcUser.mediumSolved}</dd>
									</div>
									<div class="cf-stat">
										<dt style="color:#ff375f">{competitive.leetcode.labels.hard.en}</dt>
										<dd style="color:#ff375f">{lcUser.hardSolved}</dd>
									</div>
								</dl>
							) : (
								<>
									<p class="cf-unavailable i18n i18n--en">Could not load LeetCode profile.</p>
									<p class="cf-unavailable i18n i18n--ko">LeetCode 프로필을 불러오지 못했습니다.</p>
								</>
							)
						}
						<a
							href={competitive.leetcode.profileUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="cp-link cf-card-link"
						>
							leetcode.com/edward_10
						</a>
					</div>
					<div class="cp-badge-wrap">
						<img
							src={competitive.badge.imageUrl}
							alt={competitive.badge.alt}
							width="320"
							height="160"
							loading="lazy"
						/>
						<div class="cp-badge-foot">
							<a
								href={competitive.badge.profileUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="cp-link"
							>
								{competitive.badge.handle}
							</a>
						</div>
					</div>
				</div>
			</div>

			<!-- ── Workspace divider ────────────────────────────── -->
			<div class="cp-workspace-divider reveal">
				<span class="i18n i18n--en">{codeforcesSolutionsSection.title.en}</span>
				<span class="i18n i18n--ko">{codeforcesSolutionsSection.title.ko}</span>
			</div>

			<!-- ── Workspace intro + folders ────────────────────── -->
			<div class="cf-solutions-layout">
				<div class="cf-solutions-intro reveal reveal-delay-1">
					{
						codeforcesSolutionsSection.paragraphsHtml.map((para) => (
							<>
								<p class="i18n i18n--en" set:html={para.en} />
								<p class="i18n i18n--ko" set:html={para.ko} />
							</>
						))
					}
					<div class="cf-solutions-actions">
						<a
							href={codeforcesSolutionsSection.repoUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="cp-link"
						>
							<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d={ghIconPath} />
							</svg>
							<span class="i18n i18n--en">{codeforcesSolutionsSection.viewRepoLabel.en}</span>
							<span class="i18n i18n--ko">{codeforcesSolutionsSection.viewRepoLabel.ko}</span>
						</a>
						<a href="/problems" class="cp-link">
							<span class="i18n i18n--en">Search problems ↗</span>
							<span class="i18n i18n--ko">문제 검색 ↗</span>
						</a>
					</div>
				</div>
				<div class="cf-solutions-grid">
					{
						codeforcesSolutionsSection.folders.map((folder, i) => {
							const treeUrl = `${codeforcesSolutionsSection.repoTreeBase}/${folder.path}`;
							const delay = revealDelays[i % 4];
							return (
								<div class:list={['cf-folder-card', 'reveal', `reveal-delay-${delay}`]}>
									<div class="cf-folder-path">{folder.path}/</div>
									<h3 class="cf-folder-title">
										<span class="i18n i18n--en">{folder.title.en}</span>
										<span class="i18n i18n--ko">{folder.title.ko}</span>
									</h3>
									<p class="cf-folder-desc i18n i18n--en" set:html={folder.description.en} />
									<p class="cf-folder-desc i18n i18n--ko" set:html={folder.description.ko} />
									<a href={treeUrl} target="_blank" rel="noopener noreferrer" class="cf-folder-link">
										<span class="i18n i18n--en">{codeforcesSolutionsSection.browseFolderLabel.en}</span>
										<span class="i18n i18n--ko">{codeforcesSolutionsSection.browseFolderLabel.ko}</span>
									</a>
								</div>
							);
						})
					}
				</div>
			</div>
		</div>
	</section>

	<section id="projects" class="band">
		<div class="section-inner">
			<div class="section-label" data-num="04">
				<span class="i18n i18n--en">{projectsSection.sectionLabel.en}</span>
				<span class="i18n i18n--ko">{projectsSection.sectionLabel.ko}</span>
			</div>
			<h2 class="section-title reveal">
				<span class="i18n i18n--en">{projectsSection.title.en}</span>
				<span class="i18n i18n--ko">{projectsSection.title.ko}</span>
			</h2>
			<div class="project-filter-row reveal reveal-delay-1">
				<span class="project-filter-label">
					<span class="i18n i18n--en">{projectsSection.filterLabel.en}</span>
					<span class="i18n i18n--ko">{projectsSection.filterLabel.ko}</span>
				</span>
				<div class="project-filter-buttons">
					{projectsSection.filters.map((f, i) => (
						<button
							type="button"
							class:list={['project-filter-btn', i === 0 && 'is-active']}
							data-project-filter-btn
							data-filter={f.key}
						>
							<span class="i18n i18n--en">{f.label.en}</span>
							<span class="i18n i18n--ko">{f.label.ko}</span>
						</button>
					))}
				</div>
			</div>
			<div class="projects-grid">
				{
					projectCards.map((proj, i) => {
						const num = String(i + 1).padStart(2, '0');
						const delay = revealDelays[i % 4];
						const pt = projectTitleSpans(proj.title);
						return (
							<div
								class:list={['project-card', 'reveal', `reveal-delay-${delay}`]}
								data-project-filter-item
								data-category={proj.category}
							>
								<div class="project-num">{num}</div>
								<div class="project-title">
									{pt.mode === 'single' ? (
										<span class="project-title-text">{pt.text}</span>
									) : (
										<span class="project-title-text">
											<span class="i18n i18n--en">{pt.title.en}</span>
											<span class="i18n i18n--ko">{pt.title.ko}</span>
										</span>
									)}
									<span class="project-arrow">↗</span>
								</div>
								<div class="project-meta-row">
